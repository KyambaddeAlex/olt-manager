{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'kyambaddealex55@gmail.com' && auth.token.email_verified === true) || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid && newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email && (!data.exists() || newData.child('createdAt').val() === data.child('createdAt').val())",
        ".validate": "newData.hasChildren(['uid', 'email', 'displayName', 'createdAt', 'lastSeenAt']) && !newData.child('role').exists()",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        },
        "lastSeenAt": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "activityLogs": {
      ".read": "auth != null && ((auth.token.email === 'kyambaddealex55@gmail.com' && auth.token.email_verified === true) || auth.token.admin === true)",
      "$logId": {
        ".write": "auth != null && auth.token.email_verified === true && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['id', 'actorUid', 'actorEmail', 'actorName', 'action', 'siteId', 'siteName', 'recordId', 'summary', 'timestamp'])",
        "id": { ".validate": "newData.isString() && newData.val() === $logId" },
        "actorUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "actorEmail": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
        "actorName": { ".validate": "newData.isString()" },
        "action": { ".validate": "newData.val() === 'CREATE' || newData.val() === 'UPDATE' || newData.val() === 'DELETE'" },
        "siteId": { ".validate": "newData.isString()" },
        "siteName": { ".validate": "newData.isString()" },
        "recordId": { ".validate": "newData.isString()" },
        "summary": { ".validate": "newData.isString()" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000" },
        "$other": { ".validate": false }
      }
    },
    "olts": {
      "$siteName": {
        "configs": {
          ".read": "auth != null && auth.token.email_verified === true",
          "$recordId": {
            ".write": "auth != null && auth.token.email_verified === true"
          }
        }
      }
    }
  }
}
