{
  "name": "olt-core-manager",
  "version": "1.0.0",
  "description": "OLT Core Manager mobile app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts",
    "sync": "cap copy",
    "open": "cap open android",
    "apk": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
